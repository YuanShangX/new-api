[Unit]
Description=New API PostgreSQL backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/new-api/.env

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/new-api
EnvironmentFile=-/etc/new-api/cos.env
ExecStart=/opt/new-api/scripts/backup-postgres.sh
Nice=10
